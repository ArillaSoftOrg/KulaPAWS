# Copy to .env.local and fill in real values. Never commit real values.

# Canonical site origin (no trailing slash). Required in production;
# falls back to http://localhost:3000 in local development if unset.
SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
